diff --git a/test/aws_snapsafe_test.c b/test/aws_snapsafe_test.c
new file mode 100644
index 0000000..99dcc97
--- /dev/null
+++ b/test/aws_snapsafe_test.c
@@ -0,0 +1,855 @@
+/*
+ * -----------------------------------------------------------------------------
+ * Copyright Amazon.com Inc. or its affiliates. All Rights Reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ * -----------------------------------------------------------------------------
+*/
+
+#include <openssl/provider.h>
+#include <openssl/rand.h>
+
+#include "internal/aws_snapsafe_internal.h"
+#include "../include/crypto/evp.h"
+#include "../crypto/evp/evp_local.h"
+#include "testutil.h"
+
+#ifndef FIPS_MODULE
+#include <openssl/engine.h>
+#endif
+
+#define INVARIANT_ITERATOR_COUNT 10
+#define RANDOM_SIZE 16
+OSSL_PROVIDER *fake_provider = NULL;
+
+static int sgn_stays_invariant(void) {
+    uint32_t initial_sgn = 0;
+    uint32_t current_sgn = 0;
+
+    if (!TEST_true(aws_snapsafe_get_sgn(&initial_sgn))) {
+        return 0;
+    }
+
+    for (size_t i = 0; i < INVARIANT_ITERATOR_COUNT; i++) {
+        if (!TEST_true(aws_snapsafe_get_sgn(&current_sgn))
+            || !TEST_true(initial_sgn == current_sgn)) {
+            return 0;
+        }
+    }
+
+    return 1;
+}
+
+/* Check that basic operations works and basic assumptions hold. */
+static int basic_tests(void)
+{
+    int ret = 0;
+    uint32_t sgn = 0;
+    int kernel_support_snapsafe = aws_snapsafe_is_supported();
+
+    if (kernel_support_snapsafe != 1) {
+        aws_snapsafe_enable_test_mode_FOR_TESTING();
+    }
+
+    if (kernel_support_snapsafe == 1) {
+        if (!TEST_true(RAND_snapsafe_is_supported())) {
+            goto err;
+        }
+    }
+
+    /* Polling the sgn doesn't just fail... */
+    if (!TEST_true(aws_snapsafe_get_sgn(&sgn))) {
+        goto err;
+    }
+
+    /* Verify that when we believe that snapsafety is (or is not) supported, the
+     * state actually agrees with that after polling the sgn. */
+    if (kernel_support_snapsafe == 1) {
+        if (!TEST_true(aws_snapsafe_is_initialised())) {
+            goto err;
+        }
+    } else {
+        if (!TEST_false(aws_snapsafe_is_initialised())) {
+            goto err;
+        }
+    }
+
+    /* Incrementing the sgn should increment by 1. */
+    uint32_t cached_sgn = 0;
+    uint32_t incremented_sgn = 0;
+    if (!TEST_true(aws_snapsafe_get_sgn(&cached_sgn))
+        || !TEST_true(aws_snapsafe_increment_sgn_FOR_TESTING())
+        || !TEST_true(aws_snapsafe_get_sgn(&incremented_sgn))
+        || !TEST_true((cached_sgn + 1) == incremented_sgn)) {
+        goto err;
+    }
+
+    /* If not incremented, sgn must stay invariant. */
+    if (!TEST_true(sgn_stays_invariant())
+        || !TEST_true(aws_snapsafe_increment_sgn_FOR_TESTING())
+        || !TEST_true(sgn_stays_invariant())) {
+        goto err;
+    }
+
+    ret = 1;
+
+err:
+    if (kernel_support_snapsafe != 1) {
+        aws_snapsafe_disable_test_mode_FOR_TESTING();
+    }
+    return ret;
+}
+
+/* Test some initial property values. The initial values for the default case
+ * is tested in another unit test set. */
+static int initial_values_evp_rand_ctx(void)
+{
+    int ret = 0;
+    EVP_RAND *rand = NULL;
+    EVP_RAND_CTX *rand_ctx = NULL;
+    uint32_t sgn = 0;
+
+    /* We need an EVP_RAND instance. So, simply fetch the default CTR-DRBG
+     * EVP_RAND. This emulates a non-default EVP_RAND because the workflow that
+     * tags EVP_RAND_CTXs as default are only executed when passing through the
+     * RAND_* APIs. */
+    if (!TEST_ptr(rand = EVP_RAND_fetch(NULL, "CTR-DRBG", NULL))
+        || !TEST_ptr(rand_ctx = EVP_RAND_CTX_new(rand, NULL))) {
+        goto err;
+    }
+
+    if (!TEST_true(aws_snapsafe_get_sgn(&sgn))
+        || !TEST_uint_eq((uint) rand_ctx->cached_sgn, (uint) sgn)
+        || !TEST_int_eq(rand_ctx->parent_reseed_counter, 0)
+        || !TEST_int_eq(rand_ctx->rand_provider_type, RAND_PROVIDER_NOT_DEFAULT)) {
+        goto err;
+    }
+
+    ret = 1;
+
+err:
+    EVP_RAND_free(rand);
+    EVP_RAND_CTX_free(rand_ctx);
+    return ret;
+}
