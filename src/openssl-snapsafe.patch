+ * SPDX-License-Identifier: Apache-2.0
+ * -----------------------------------------------------------------------------
+*/
+
+#ifndef OSSL_INTERNAL_AWS_SNAPSAFE_INTERNAL_h
+# define OSSL_INTERNAL_AWS_SNAPSAFE_INTERNAL_h
+
+#include <stddef.h>
+
+#include <openssl/types.h>
+
+/* We allow snapsafe detection functions to run at most
+ * AWS_SNAPSAFE_DETECT_LIMIT times. Calling the detection function in an
+ * infinite loop is almost certainly a bug somewhere in the the application
+ * running under snapstart. Set limit low to bail fast, avoiding many active
+ * Lambda's that are just spinning out of control. */
+#define AWS_SNAPSAFE_DETECT_LIMIT 10
+
+typedef enum {
+    RAND_PROVIDER_NOT_DEFAULT,
+    RAND_PROVIDER_DEFAULT_SEED,
+    RAND_PROVIDER_DEFAULT_PRIMARY,
+    RAND_PROVIDER_DEFAULT_SECONDARY
+} RAND_PROVIDER_TYPE;
+
+#define SNAPSAFE_EVP_RAND_CB_GENERATE 0x00
+#define SNAPSAFE_EVP_RAND_CB_NONCE 0x01
+
+struct snapsafe_evp_rand_stack {
+    uint8_t cb_type;
+    unsigned char *out;
+    size_t outlen;
+    unsigned int strength;
+    int prediction_resistance;
+    const unsigned char *addin;
+    size_t addin_len;
+};
+
+int aws_snapsafe_get_sgn(uint32_t *sgn);
+void AWS_SNAPSAFE_EVP_RAND_set_provider_type(EVP_RAND_CTX *ctx,
+    RAND_PROVIDER_TYPE type);
+uint32_t AWS_SNAPSAFE_EVP_RAND_get_snapsafe_generation_number(EVP_RAND_CTX *ctx);
+int AWS_SNAPSAFE_EVP_RAND_is_default_seed(EVP_RAND_CTX *ctx);
+int AWS_SNAPSAFE_EVP_RAND_is_default_primary(EVP_RAND_CTX *ctx);
+int aws_snapsafe_is_supported(void);
+int aws_snapsafe_is_initialised(void);
+int aws_snapsafe_get_entropy(unsigned char *buf, size_t buf_size);
+void aws_snapsafe_enable_test_mode_FOR_TESTING(void);
+void aws_snapsafe_disable_test_mode_FOR_TESTING(void);
+int aws_snapsafe_increment_sgn_FOR_TESTING(void);
+
+#endif /* OSSL_INTERNAL_AWS_SNAPSAFE_INTERNAL_h */
