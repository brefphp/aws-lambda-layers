+/* This test aims at testing the reseed logic for engines. Reseeding should
+ * happen if the sgn is different from the cached sgn and if randomness is
+ * requested through one of the public rand function. */
+static int engine_reseed_check(void)
+{
+    int ret = 0;
+    size_t expect_func_value_count = 0;
+    unsigned char buf[RANDOM_SIZE];
+    int kernel_support_snapsafe = aws_snapsafe_is_supported();
+
+    if (kernel_support_snapsafe != 1) {
+        aws_snapsafe_enable_test_mode_FOR_TESTING();
+    }
+
+    /* Mock the registered engine to count how many times each callback has been
+     * invoked. */
+    if (!TEST_true(create_rand_engine(SNAPSAFE_TEST_ENGINE_RESEED_ENGINE_ID,
+                        &snapsafe_test_engine_reseed_rand_method,
+                        "snapsafe reseeding test engine"))) {
+        goto err;
+    }
+    if (!TEST_true(register_rand_engine(SNAPSAFE_TEST_ENGINE_RESEED_ENGINE_ID))) {
+        goto err;
+    }
+
+   /* For F = {RAND_bytes(), RAND_bytes_ex(), RAND_pseudo_bytes(),
+     * RAND_priv_bytes(), RAND_priv_bytes_ex()}, we do:
+     * 1) cache sgn by calling F
+     * 2) increment sgn
+     * 3) reset test flags
+     * 4) call F
+     * 5) expect test flags to be incremented (flag depends on F)
+     * 6) call F
+     * 7) expect test flags to be incremented except add callback flag */
+    int (*rand_func[3])(unsigned char *, int) = {
+        RAND_bytes, RAND_priv_bytes, RAND_pseudo_bytes
+    };
+    for (size_t i = 0; i < 3; i++) {
+        if (!TEST_true(rand_func[i](buf, RANDOM_SIZE))) {
+            goto err;
+        }
+
+        reset_snapsafe_engine_test_flags();
+        if (!TEST_true(aws_snapsafe_increment_sgn_FOR_TESTING())
+            || !TEST_true(rand_func[i](buf, RANDOM_SIZE))) {
+            goto err;
+        }
+
+        /* RAND_pseudy_bytes use a different callback than RAND[_priv]_bytes. */
+        if (rand_func[i] == RAND_pseudo_bytes) {
+            expect_func_value_count = test_engine_pseudo_bytes_count;
+
+        } else {
+            expect_func_value_count = test_engine_bytes_count;
+        }
+        if (!TEST_uint_eq(test_engine_reseed_count, 1)
+            || !TEST_uint_eq(expect_func_value_count, 1)) {
+            goto err;
+        }
+
+        /* Generating randomness without a resume event should not cause a
+         * reseed. */
+        if (!TEST_true(rand_func[i](buf, RANDOM_SIZE))) {
+            goto err;
+        }
+        if (rand_func[i] == RAND_pseudo_bytes) {
+            expect_func_value_count = test_engine_pseudo_bytes_count;
+        } else {
+            expect_func_value_count = test_engine_bytes_count;
+        }
+        if (!TEST_uint_eq(test_engine_reseed_count, 1)
+            || !TEST_uint_eq(expect_func_value_count, 2)) {
+            goto err;
+        }
+    }
+
+
+    int (*rand_func_ex[2])(OSSL_LIB_CTX *ctx, unsigned char *, size_t,
+            unsigned int) = {
+        RAND_bytes_ex, RAND_priv_bytes_ex
+    };
+    for (size_t i = 0; i < 2; i++) {
+        if (!TEST_true(rand_func_ex[i](NULL, buf, RANDOM_SIZE, 0))) {
+            goto err;
+        }
+
+        reset_snapsafe_engine_test_flags();
+        if (!TEST_true(aws_snapsafe_increment_sgn_FOR_TESTING())
+            || !TEST_true(rand_func_ex[i](NULL, buf, RANDOM_SIZE, 0))) {
+            goto err;
+        }
+
+        if (!TEST_uint_eq(test_engine_reseed_count, 1)
+            || !TEST_uint_eq(test_engine_bytes_count, 1)) {
+            goto err;
+        }
+
+        /* Generating randomness without a resume event should not cause a
+         * reseed. */
+        if (!TEST_true(rand_func_ex[i](NULL, buf, RANDOM_SIZE, 0))
+            || !TEST_uint_eq(test_engine_reseed_count, 1)
+            || !TEST_uint_eq(test_engine_bytes_count, 2)) {
+            goto err;
+        }
+    }
+
+    ret = 1;
+err:
+    aws_snapsafe_disable_test_mode_FOR_TESTING();
+    cleanup_rand_engine(SNAPSAFE_TEST_ENGINE_RESEED_ENGINE_ID);
+    return ret;
+}
+
+/* This test aims at testing the reseed logic for engines. Reseeding should
+ * happen if the sgn is different from the cached sgn and if randomness is
+ * requested through one of the public rand function. */
+static int engine_retry_check(void)
+{
+    int ret = 0;
+    size_t expect_func_value_count = 0;
+    unsigned char buf[RANDOM_SIZE];
+    uint32_t *sgn = 0;
+    int kernel_support_snapsafe = aws_snapsafe_is_supported();
+
+    if (kernel_support_snapsafe != 1) {
+        aws_snapsafe_enable_test_mode_FOR_TESTING();
+    }
+
+    /* Mock the registered engine to count how many times each callback has been
+     * invoked. */
+    if (!TEST_true(create_rand_engine(SNAPSAFE_TEST_ENGINE_RETRY_ENGINE_ID,
+                        &snapsafe_test_engine_retry_rand_method,
+                        "snapsafe retry test engine"))) {
+        goto err;
+    }
+    if (!TEST_true(register_rand_engine(SNAPSAFE_TEST_ENGINE_RETRY_ENGINE_ID))) {
+        goto err;
+    }
+
+    /* For F = {RAND_bytes(), RAND_bytes_ex(), RAND_pseudo_bytes(),
+     * RAND_priv_bytes(), RAND_priv_bytes_ex()}, we do:
+     * 1) cache sgn by calling F
+     * 2) increment sgn
+     * 3) reset test flags
+     * 4) call F - each call will increment the sgn and thereby kickoff a retry
+     * 5) expect test flags to be incremented (flag depends on F) by
+     *    AWS_SNAPSAFE_DETECT_LIMIT and function to fail */
+    int (*rand_func[3])(unsigned char *, int) = {
+        RAND_bytes, RAND_priv_bytes, RAND_pseudo_bytes
+    };
+    for (size_t i = 0; i < 3; i++) {
+        /* The callback will retry until reaching the snapsafe retry limit. So,
+         * this should also fail. */
+        if (!TEST_false(rand_func[i](buf, RANDOM_SIZE))) {
+            goto err;
+        }
+
+        reset_snapsafe_engine_test_flags();
+        if (!TEST_true(aws_snapsafe_increment_sgn_FOR_TESTING())
+            || !TEST_false(rand_func[i](buf, RANDOM_SIZE))) {
+            goto err;
+        }
+
+        /* RAND_pseudy_bytes use a different callback than RAND[_priv]_bytes. */
+        if (rand_func[i] == RAND_pseudo_bytes) {
+            expect_func_value_count = test_engine_pseudo_bytes_count;
+
+        } else {
+            expect_func_value_count = test_engine_bytes_count;
+        }
+        if (!TEST_uint_eq(test_engine_reseed_count, AWS_SNAPSAFE_DETECT_LIMIT)
+            || !TEST_uint_eq(expect_func_value_count, AWS_SNAPSAFE_DETECT_LIMIT)) {
+            goto err;
+        }
+    }
+
+    int (*rand_func_ex[2])(OSSL_LIB_CTX *ctx, unsigned char *, size_t,
+            unsigned int) = {
+        RAND_bytes_ex, RAND_priv_bytes_ex
+    };
+    for (size_t i = 0; i < 2; i++) {
+        if (!TEST_false(rand_func_ex[i](NULL, buf, RANDOM_SIZE, 0))) {
+            goto err;
+        }
+
+        reset_snapsafe_engine_test_flags();
+        if (!TEST_true(aws_snapsafe_increment_sgn_FOR_TESTING())
+            || !TEST_false(rand_func_ex[i](NULL, buf, RANDOM_SIZE, 0))) {
+            goto err;
+        }
+
+        if (!TEST_uint_eq(test_engine_reseed_count, AWS_SNAPSAFE_DETECT_LIMIT)
+            || !TEST_uint_eq(test_engine_bytes_count, AWS_SNAPSAFE_DETECT_LIMIT)) {
+            goto err;
+        }
+    }
+
+    ret = 1;
+err:
+    aws_snapsafe_disable_test_mode_FOR_TESTING();
+    cleanup_rand_engine(SNAPSAFE_TEST_ENGINE_RETRY_ENGINE_ID);
+    return ret;
+}
+
+#endif
+
+int setup_tests(void)
+{
+    ADD_TEST(basic_tests);
+    ADD_TEST(initial_values_evp_rand_ctx);
+    ADD_TEST(default_rand_code_path);
+    ADD_TEST(default_provider_reseed_check);
+    ADD_TEST(non_default_provider_reseed_check);
+    ADD_TEST(nonce_reseed_check);
+#ifndef FIPS_MODULE
+    ADD_TEST(engine_reseed_check);
+    ADD_TEST(engine_retry_check);
+#endif
+
+    return 1;
+}
