+/* Snapsafety for engines is only relevant for non-FIPS build. The FIPS build
+ * completely invalidates the use of engines. */
+#define SNAPSAFE_ENGINE_CB_BYTES 0x00
+#define SNAPSAFE_ENGINE_CB_PSEUDO_BYTES 0x01
+#define AWS_SNAPSAFE_ENGINE_ENTROPY_SIZE_BYTES 32
+__thread uint32_t per_thread_cached_engine_sgn = 0;
+
+static int aws_snapsafe_handle_engine(const RAND_METHOD *rand_engine, int *detected)
+{
+    int ret = 0;
+    uint32_t current_sgn = 0;
+    unsigned char buf[AWS_SNAPSAFE_ENGINE_ENTROPY_SIZE_BYTES];
+
+    *detected = 0;
+    if (aws_snapsafe_get_sgn(&current_sgn) != 1) {
+        return 0;
+    }
+
+    if (per_thread_cached_engine_sgn != current_sgn) {
+        /* Resume detected!
+         * Best effort randomisation of the engine by adding entropy through the
+         * add callback.
+         *
+         * The add callback is the only method we can use to induce a reseed in
+         * the engine. Without this callback, we can't actually do anything...
+         * We do not want to start failing existing software, but current state
+         * is potentially unsafe for the application. Be on the safe side and
+         * fail with an error message output. */
+        if (rand_engine->add == NULL) {
+            fprintf(stderr, "\n\n ERROR: |add| callback in the registered engine is not implemented."
+                "But a snapshot resume has been detected and it is unsafe to proceed with generating data."
+                "Please implement the |add| callback in the registered engine."
+                "Please contact AWS support if unsure how to handle this error message.\n\n");
+            goto end;
+        }
+
+        *detected = 1;
+        if (aws_snapsafe_get_entropy(buf,
+                AWS_SNAPSAFE_ENGINE_ENTROPY_SIZE_BYTES) != 1) {
+            goto end;
+        }
+        if (rand_engine->add(buf, AWS_SNAPSAFE_ENGINE_ENTROPY_SIZE_BYTES,
+                AWS_SNAPSAFE_ENGINE_ENTROPY_SIZE_BYTES) != 1) {
+            goto end;
+        }
+
+        per_thread_cached_engine_sgn = current_sgn;
+    }
+
+    ret = 1;
+
+end:
+    memset(buf, 0, AWS_SNAPSAFE_ENGINE_ENTROPY_SIZE_BYTES);
+    return ret;
+}
+
+static int aws_snapsafe_engine_execute_callback(const RAND_METHOD *rand_engine,
+    unsigned char *buf, size_t num, int callback_type)
+{
+    int ret = 0;
+
+    switch (callback_type) {
+        case SNAPSAFE_ENGINE_CB_BYTES:
+            if (rand_engine->bytes(buf, num) != 1) {
+                goto end;
+            }
+            break;
+        case SNAPSAFE_ENGINE_CB_PSEUDO_BYTES:
+            if (rand_engine->pseudorand(buf, num) != 1) {
+                goto end;
+            }
+            break;
+        default:
+            /* Not supposed to happen. So, Fail. */
+            goto end;
+    }
+
+    ret = 1;
+
+end:
+    return ret;
+}
+
+static int aws_snapsafe_engine_iterate(const RAND_METHOD *rand_engine,
+    unsigned char *buf, size_t num, int callback_type)
+{
+    int ret = 0;
+    int detected = 0;
+    size_t detect_count = 0;
+
+    if (!CRYPTO_THREAD_write_lock(rand_engine_lock)) {
+        goto end;
+    }
+
+    do {
+        detected = 0;
+        if (aws_snapsafe_handle_engine(rand_engine, &detected) != 1) {
+            goto end;
+        }
+
+        /* On first iteration, this check is ignored because we need to generate
+         * some randomness we can output.
+         * From second iteration onward, we only generate randomness again if we
+         * had detected a resume. */
+        if (detect_count > 0 && detected != 1) {
+            /* We already generated randomness successfully and no new resume
+             * was detected. We can return now. */
+            ret = 1;
+            goto end;
+        }
+
+        if (aws_snapsafe_engine_execute_callback(rand_engine, buf, num,
+                callback_type) != 1) {
+            goto end;
+        }
+
+        detect_count = detect_count + 1;
+    } while (detect_count < AWS_SNAPSAFE_DETECT_LIMIT);
+
+end:
+    CRYPTO_THREAD_unlock(rand_engine_lock);
+    return ret;
+}
