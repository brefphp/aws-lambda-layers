+static int test_rand_snapsafe_default_provider_type(void) {
+
+    int ret = 0;
+    EVP_RAND_CTX *primary, *public, *private;
+    unsigned char random[RANDOM_SIZE];
+
+    /* Make sure everything is initialised */
+    if (!TEST_true(RAND_bytes(random, RANDOM_SIZE))
+        || !TEST_true(RAND_priv_bytes(random, RANDOM_SIZE))) {
+        goto err;
+    }
+
+    /* Get default drbgs */
+    if (!TEST_ptr(primary = RAND_get0_primary(NULL))
+        || !TEST_ptr(public = RAND_get0_public(NULL))
+        || !TEST_ptr(private = RAND_get0_private(NULL))) {
+        goto err;
+    }
+
+    /* Verify that default implementations are tagged correctly */
+    if (!TEST_int_eq(primary->rand_provider_type, RAND_PROVIDER_DEFAULT_PRIMARY)
+        || !TEST_int_eq(public->rand_provider_type, RAND_PROVIDER_DEFAULT_SECONDARY)
+        || !TEST_int_eq(private->rand_provider_type, RAND_PROVIDER_DEFAULT_SECONDARY)
+        || !TEST_ptr(primary->parent)
+        || !TEST_int_eq(primary->parent->rand_provider_type, RAND_PROVIDER_DEFAULT_SEED)) {
+        goto err;
+    }
+
+    ret = 1;
+
+err:
+    return ret;
+}
