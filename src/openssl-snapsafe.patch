+static int create_rand_engine(char *id, RAND_METHOD *method, char *name)
+{
+
+    int ret = 0;
+
+    ENGINE *engine = ENGINE_new();
+    if (engine == NULL) {
+        goto err;
+    }
+    if (!TEST_true(ENGINE_set_id(engine, id))) {
+        goto err;
+    }
+    if (!TEST_true(ENGINE_set_name(engine, name))) {
+        goto err;
+    }
+    if (!TEST_true(ENGINE_set_flags(engine, ENGINE_FLAGS_NO_REGISTER_ALL))) {
+        goto err;
+    }
+    if (!TEST_true(ENGINE_set_init_function(engine, snapsafe_test_engine_init))) {
+        goto err;
+    }
+    if (!TEST_true(ENGINE_set_RAND(engine, method))) {
+        goto err;
+    }
+    if (!TEST_true(ENGINE_add(engine))) {
+        goto err;
+    }
+
+    ret = 1;
+
+err:
+    if (engine != NULL) {
+        ENGINE_free(engine);
+    }
+    return ret;
+}
