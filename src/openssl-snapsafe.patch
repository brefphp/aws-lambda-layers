+/* AWS_SNAPSAFE_EVP_RAND_set_provider_type sets the provider type of ctx to
+ * type. Does nothing if ctx is null. */
+void AWS_SNAPSAFE_EVP_RAND_set_provider_type(EVP_RAND_CTX *ctx,
+    RAND_PROVIDER_TYPE type)
+{
+    if (ctx != NULL) {
+        ctx->rand_provider_type = type;
+    }
+}
+
+/* AWS_SNAPSAFE_EVP_RAND_is_default_seed returns one if ctx is tagged as the
+ * default seed and 0 otherwise. */
+int AWS_SNAPSAFE_EVP_RAND_is_default_seed(EVP_RAND_CTX *ctx) {
+    if (ctx->rand_provider_type == RAND_PROVIDER_DEFAULT_SEED) {
+        return 1;
+    }
+    return 0;
+}
+
+/* AWS_SNAPSAFE_EVP_RAND_is_default_primary returns 1 if ctx is tagged as the
+ * default primary and 0 otherwise. */
+int AWS_SNAPSAFE_EVP_RAND_is_default_primary(EVP_RAND_CTX *ctx) {
+    if (ctx->rand_provider_type == RAND_PROVIDER_DEFAULT_PRIMARY) {
+        return 1;
+    }
+    return 0;
+}
+
+/* AWS_SNAPSAFE_EVP_RAND_get_snapsafe_generation_number returns the snapsafe
+ * generation number cached in ctx. */
+uint32_t AWS_SNAPSAFE_EVP_RAND_get_snapsafe_generation_number(EVP_RAND_CTX *ctx)
+{
+    return ctx->cached_sgn;
+}
+
+/* aws_snapsafe_parent_must_reseed returns 1 if ctx's parent needs to be
+ * reseeded, and 0 otherwise. new_sgn must be the sgn used to detect an resume
+ * event. */
+static int aws_snapsafe_parent_must_reseed(EVP_RAND_CTX *ctx, uint32_t new_sgn)
+{
+    if (ctx->parent != NULL
+        && ctx->parent->cached_sgn != new_sgn) {
+        return 1;
+    }
+    return 0;
+}
+
+/* From the initial object (ctx) we consider its sequence of parent's as a
+ * linked list up to a root, i.e. the list L:
+ *
+ * ctx -> ctx.parent -> ctx.parent.parent -> ... -> ctx.parent.parent...parent.
+ *
+ * Denote each entry in the list by L[i]. That is, initial object (ctx) is L[0],
+ * ctx.parent is L[1], etc.
+ *
+ * For this linked list we maintain the following invariant:
+ *   If L[i] does not need to be reseeded, then L[j] for j > i does not need to
+ *   be reseeded either.
+ *
+ * This invariant is guaranteed if we use the snapsafe generation number (sgn)
+ * to indicate the need for a reseed, since the sgn it's monotonically
+ * increasing.
+ *
+ * Using the invariant, we can limit the recursion up until the first object in
+ * the list that does not need to reseed. This is important because a parent is
+ * a 1-to-many relationship with children, that could cause many redundant
+ * reseeds otherwise. */
+static int aws_snapsafe_handle_non_default_provider(EVP_RAND_CTX *ctx,
+    uint32_t new_sgn)
+{
+    int ret = 0;
+    unsigned char *buf = NULL;
+
+    if (ctx == NULL) {
+        /* Not an error. It just stops recursion. */
+        return 1;
+    }
+
+    if (!evp_rand_lock(ctx)) {
+        goto err;
+    }
+
+    if (aws_snapsafe_parent_must_reseed(ctx, new_sgn) == 1) {
+        if (aws_snapsafe_handle_non_default_provider(ctx->parent, new_sgn) != 1) {
+            goto err;
+        }
+    }
+
+    unsigned int strength = evp_rand_strength_locked(ctx);
+    if (strength == 0) {
+        goto err;
+    }
+
+    /* Strength is the number of entropy bits. Assuming perfect entropy rate of
+     * 8 bits per byte, we can get the length of the buffer by dividing by 8.
+     * This is a typical assumption when drawing entropy from system sources. */
+    size_t buf_size = (strength + 7) / 8;
+    buf = malloc(buf_size);
+
+    if (buf == NULL) {
+        goto err;
+    }
+    if (aws_snapsafe_get_entropy(buf, buf_size) != 1) {
+        goto err;
+    }
+    if (evp_rand_reseed_locked(ctx, 0, buf, buf_size, NULL, 0) != 1) {
+        goto err;
+    }
+
+    ctx->cached_sgn = new_sgn;
+    ret = 1;
+
+err:
+    if (buf != NULL) {
+        memset(buf, 0, buf_size);
+    }
+    free(buf);
+    evp_rand_unlock(ctx);
+    return ret;
+}
+
+/* For the default drbg implementation, we can offload part of the work to the
+ * implementation. When reseeding the primary, it will automatically force a
+ * reseed of its children ("public" and "private"). The default seed source for
+ * the primary is the EVP_RAND SEED-SRC implementation. But the SEED-SRC
+ * implementation doesn't cache any material.
+ *
+ * This is a good optimisation using implementation details. The reseed entropy
+ * used in the default implementation is gathered regardless of the arguments
+ * passed to EVP_RAND_reseed. Hence, we can avoid doing 2x reseeds and 2x entropy
+ * gathering by not supplying any entropy or additional data in the high-level
+ * reseed function invocation. In the general case, we cannot make this
+ * assumption so it makes sense to factor out the default case, which will be
+ * the most common by far. */
+static int aws_snapsafe_handle_default_provider(EVP_RAND_CTX *ctx,
+    uint32_t new_sgn)
+{
+    int ret = 0;
+
+    if (ctx == NULL) {
+        return 0;
+    }
+
+    if (!evp_rand_lock(ctx)) {
+        return 0;
+    }
+
+    if (ctx->cached_sgn == new_sgn) {
+        /* Only spend resources if this drbg has not been reseeded before. This
+         * situation can occur, for example, if the primary is reseeded because
+         * of a resume event in the private drbg. But later the same resume
+         * event is detected for the public drbg. */
+        ret = 1;
+        goto end;
+    }
+
+    if (ctx->rand_provider_type == RAND_PROVIDER_DEFAULT_SECONDARY) {
+        /* Will automatically reseed when parent (primary) has reseeded */
+        ret = aws_snapsafe_handle_default_provider(ctx->parent, new_sgn);
+    } else if (ctx->rand_provider_type == RAND_PROVIDER_DEFAULT_PRIMARY) {
+        if (evp_rand_reseed_locked(ctx, 0, NULL, 0, NULL, 0) != 1) {
+            goto end;
+        }
+        ret = aws_snapsafe_handle_default_provider(ctx->parent, new_sgn);
+    } else if (ctx->rand_provider_type == RAND_PROVIDER_DEFAULT_SEED) {
+        /* Default Seed EVP_RAND. Nothing to do. Just make sure to update sgn.
+         * Will only hit this case if some consumer wants to generate
+         * randomness directly from the default seed via the EVP_RAND API.
+         * This would be strange, but handle it correctly anyway.
+         * Yes, we need to handle this case, because the EVP_RAND interface
+         * might take the SEED-SRC as an input! */
+        ret = 1;
+    }
+
+    if (ret == 1) {
+        ctx->cached_sgn = new_sgn;
+    }
+
+end:
+    evp_rand_unlock(ctx);
+    return ret;
+}
+
+/* Detects if ctx belongs to the default implementation and sanity checks that
+ * no custom drbg has been injected into the (known) linked list of drbg's. */
+static int aws_snapsafe_is_default_provider(EVP_RAND_CTX *ctx)
+{
+    if (ctx->rand_provider_type == RAND_PROVIDER_DEFAULT_SEED) {
+        return 1;
+    }
+
+    if (ctx->rand_provider_type == RAND_PROVIDER_DEFAULT_PRIMARY
+        && ctx->parent != NULL
+        && aws_snapsafe_is_default_provider(ctx->parent) == 1) {
+        return 1;
+    }
+
+    if (ctx->rand_provider_type == RAND_PROVIDER_DEFAULT_SECONDARY
+        && ctx->parent != NULL
+        && aws_snapsafe_is_default_provider(ctx->parent)) {
+        return 1;
+    }
+
+    return 0;
+}
+
+/* aws_snapsafe_handle_provider decides which reseed strategy to use based on
+ * the implementation associated to ctx. */
+static int aws_snapsafe_handle_provider(EVP_RAND_CTX *ctx, int *detected)
+{
+    uint32_t current_sgn = 0;
+
+    *detected = 0;
+
+    if (aws_snapsafe_get_sgn(&current_sgn) != 1) {
+        return 0;
+    }
+
+    if (ctx->cached_sgn != current_sgn) {
+        /* Resume detected! */
+        *detected = 1;
+        if (aws_snapsafe_is_default_provider(ctx) == 1) {
+            return aws_snapsafe_handle_default_provider(ctx, current_sgn);
+        } else {
+            return aws_snapsafe_handle_non_default_provider(ctx, current_sgn);
+        }
+    }
+
+    return 1;
+}
+
+static int aws_snapsafe_evp_rand_execute_cb(EVP_RAND_CTX *ctx,
+    struct snapsafe_evp_rand_stack *stack)
+{
+    int ret = 0;
+
+    if (!evp_rand_lock(ctx)) {
+        return 0;
+    }
+
+    /* Can't return from inside the switch block, otherwise we leave ctx
+     * locked. */
+    switch (stack->cb_type) {
+        case SNAPSAFE_EVP_RAND_CB_GENERATE:
+            if (evp_rand_generate_locked(ctx, stack->out, stack->outlen,
+                    stack->strength, stack->prediction_resistance,
+                    stack->addin, stack->addin_len) != 1) {
+                goto err;
+            }
+            break;
+        case SNAPSAFE_EVP_RAND_CB_NONCE:
+            if (evp_rand_nonce_locked(ctx, stack->out, stack->outlen) != 1) {
+                goto err;
+            }
+            break;
+        default:
+            /* Not supposed to happen. So, fail. */
+            goto err;
+    }
+
+    ret = 1;
+
+err:
+    evp_rand_unlock(ctx);
+    return ret;
+}
+
+/* To avoid having to implement the iteration logic in multiple functions, the
+ * logic is implemented once in aws_snapsafe_evp_rand_iterate. The issue is
+ * calling the correct function inside the iterator. C doesn't support calling
+ * functions via function pointers that are cast to whatever function type
+ * we want. Hence, we can't really add a function pointer argument that
+ * abstracts the set of functions (they have different function types...).
+ *
+ * I chose to fake support for the above feature using an inline stack where I
+ * push function arguments for the function I want to call. In addition, a tag
+ * that indicates which function I want to call. Another approach could be
+ * defining a variadic function. But I find the former solution cleaner, safer,
+ * and more explicit.
+ *
+ * Could likely optimise packing of snapsafe_evp_stack if the small memory
+ * overhead becomes an issue. */
+static int aws_snapsafe_evp_rand_iterate(EVP_RAND_CTX *ctx,
+    struct snapsafe_evp_rand_stack *stack) {
+
+    int ret = 0;
+    int detected = 0;
+    size_t detect_count = 0;
+
+    do {
+        detected = 0;
+        if (aws_snapsafe_handle_provider(ctx, &detected) != 1) {
+            goto end;
+        }
+
+        /* On first iteration, this check is ignored because we need to generate
+         * some randomness we can output.
+         * From second iteration onward, we only generate randomness again if
+         * we had detected a resume. */
+        if (detect_count > 0 && detected != 1) {
+            /* We already generated randomness successfully and no new resume
+             * was detected. We can return now. */
+            ret = 1;
+            goto end;
+        }
+
+        if (aws_snapsafe_evp_rand_execute_cb(ctx, stack) != 1) {
+            goto end;
+        }
+
+        detect_count = detect_count + 1;
+    } while (detect_count < AWS_SNAPSAFE_DETECT_LIMIT);
+
+end:
+    return ret;
+}
 
