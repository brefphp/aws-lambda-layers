+static int register_rand_engine(char *id)
+{
+
+    int ret = 0;
+
+    ENGINE *engine = ENGINE_by_id(id);
+    if (!TEST_ptr(engine)) {
+        goto err;
+    }
+    if (!TEST_true(ENGINE_init(engine))) {
+        goto err;
+    }
+
+    if (!TEST_true(ENGINE_set_default(engine, ENGINE_METHOD_RAND))) {
+        goto err;
+    }
+
+    if (ENGINE_get_default_RAND() != engine) {
+        goto err;
+    }
+
+    /* Override the globally cached method that RAND[_priv]_bytes_ex pull. */
+    if (!TEST_true(RAND_set_rand_method(ENGINE_get_RAND(engine)))) {
+        goto err;
+    }
+
+    ret = 1;
+
+err:
+    if (engine != NULL) {
+        ENGINE_free(engine);
+    }
+    return ret;
+}
