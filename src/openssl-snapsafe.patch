+/* Snapsafety state */
+#define SNAPSAFETY_STATE_FAILED_INITIALISE 0x00
+#define SNAPSAFETY_STATE_SUCCESS_INITIALISE 0x01
+#define SNAPSAFETY_STATE_NOT_SUPPORTED 0x02
+
+static CRYPTO_RWLOCK *sgn_mutex;
+#if defined(FIPS_MODULE)
+static int aws_snapsafe_init_once = 0;
+#else
+static CRYPTO_ONCE aws_snapsafe_init = CRYPTO_ONCE_STATIC_INIT;
+#endif
+
+/* Test mode state */
+#define SNAPSAFE_TEST_MODE_DISABLED 0x00
+#define SNAPSAFE_TEST_MODE_ENABLED 0x01
+static int test_mode = 0;
+static uint32_t test_mode_sgn = 0;
+
+/* Sysgenid state */
+/* These values can be found here: https://lkml.org/lkml/2021/3/8/677 */
+#define SYSGENID_IOCTL                  0xE4
+#define SYSGENID_TRIGGER_GEN_UPDATE     _IO(SYSGENID_IOCTL, 3)
+static const char *sgc_file_path = "/dev/sysgenid";
+static volatile uint32_t *sgc_addr = NULL;
+
+static int snapsafety_state = SNAPSAFETY_STATE_FAILED_INITIALISE;
+
+/* aws_snapsafe_check_kernel_support returns 1 if the special sysgenid device
+ * file exists and 0 otherwise. */
+static int aws_snapsafe_check_kernel_support(void)
+{
+    /* This file-exist method is generally brittle. But for our purpose, this
+     * should be more than fine. */
+    if (access(sgc_file_path, F_OK) != 0) {
+        return 0;
+    }
+    return 1;
+}
+
+static int do_aws_snapsafe_init(void)
+{
+
+    /* Storage duration is the entire life-time of the program. */
+    sgn_mutex = CRYPTO_THREAD_lock_new();
+    if (sgn_mutex == NULL) {
+        return 0;
+    }
+
+    if (aws_snapsafe_check_kernel_support() != 1) {
+        snapsafety_state = SNAPSAFETY_STATE_NOT_SUPPORTED;
+        return 1;
+    }
+
+    /* While not totally obvious from man pages, mmap actually only allocates
+     * memory on page size boundaries. So just give it that hint. */
+    long page_size = sysconf(_SC_PAGESIZE);
+    if (page_size <= 0) {
+        snapsafety_state = SNAPSAFETY_STATE_FAILED_INITIALISE;
+        return 0;
+    }
+
+    if (sgc_addr == NULL) {
+
+        int fd_sgc = open(sgc_file_path, O_RDONLY);
+        if (fd_sgc == -1) {
+            snapsafety_state = SNAPSAFETY_STATE_FAILED_INITIALISE;
+            return 0;
+        }
+
+        void *addr = mmap(NULL, (size_t) page_size, PROT_READ, MAP_SHARED,
+            fd_sgc, 0);
+
+        /* Can close file descriptor now per https://man7.org/linux/man-pages/man2/mmap.2.html:
+         * "After the mmap() call has returned, the file descriptor, fd, can be
+         * closed immediately without invalidating the mapping.".
+         * We have initialised snapsafety without errors and this function is
+         * only executed once. Therefore, try to close file descriptor but don't
+         * error if it fails. */
+        close(fd_sgc);
+
+        if (addr == MAP_FAILED) {
+            snapsafety_state = SNAPSAFETY_STATE_FAILED_INITIALISE;
+            return 0;
+        }
+
+        /* sgc_addr will now point at the mapped memory and any 4-byte read from
+         * this pointer will correspond to the sgn manager by the VMM. */
+        sgc_addr = addr;
+
+        snapsafety_state = SNAPSAFETY_STATE_SUCCESS_INITIALISE;
+    }
+
+    return 1;
+}
+
+#if defined(FIPS_MODULE)
+
+/* The following is true for the FIPS module build:
+ * "Initialisation of global data should never happen via "RUN_ONCE" inside the
+ * FIPS module. Global data should instead always be associated with a specific
+ * OSSL_LIB_CTX object. In this way data will get cleaned up correctly when the
+ * module gets unloaded.
+ *
+ * Snapsafe is not designed for the FIPS module. But make it work anyway, to
+ * pass the build and tests.
+ */
+static int do_aws_snapsafe_init_once(void)
+{
+    if (aws_snapsafe_init_once == 1) {
+        return 1;
+    }
+    aws_snapsafe_init_once = 1;
+    return do_aws_snapsafe_init();
+}
+
+/* FIPS module also doesn't link the same way with the rest of the compilation
+ * units. One case is the entropy sources. Also make this work in FIPS mode to
+ * avoid modifying the build scripts too much. The snapsafe patch doesn't
+ * support the FIPS module, so this is a cheap way to circumvent the entropy
+ * sourcing issue.
+ */
+static int aws_snapsafe_get_entropy_from_source(void *buf, size_t buf_size)
+{
+    /* check output size here... */
+    if (getrandom(buf, buf_size, 0) != buf_size) {
+        return 0;
+    }
+    return 1;
+}
+
+#else /* defined(FIPS_MODULE) */
+
+DEFINE_RUN_ONCE_STATIC(do_aws_snapsafe_init_no_fips)
+{
+    return do_aws_snapsafe_init();
+}
+
+static int do_aws_snapsafe_init_once(void)
+{
+    if (!RUN_ONCE(&aws_snapsafe_init, do_aws_snapsafe_init_no_fips)) {
+        return 0;
+    }
+    return 1;
+}
+
+static int aws_snapsafe_get_entropy_from_source(void *buf, size_t buf_size)
+{
+    int ret = 0;
+
+    RAND_POOL *pool = ossl_rand_pool_new(buf_size * 8, 1, buf_size,
+        RAND_POOL_MAX_LENGTH);
+    if (pool == NULL) {
+        return 0;
+    }
+
+    if (ossl_pool_acquire_entropy(pool) == 0) {
+        goto err;
+    }
+
+    if (buf_size != ossl_rand_pool_length(pool)) {
+        goto err;
+    }
+
+    memcpy(buf, ossl_rand_pool_buffer(pool), buf_size);
+
+    ret = 1;
+
+err:
+    ossl_rand_pool_free(pool);
+    return ret;
+}
+
+#endif /* defined(FIPS_MODULE) */
+
+static uint32_t aws_snapsafe_read_sgn(void)
+{
+    if (snapsafety_state == SNAPSAFETY_STATE_SUCCESS_INITIALISE) {
+        return *sgc_addr;
+    }
+
+    return 0;
+}
+
+/* This function will lazily initialise snapsafety.
+ * It will "fail" open if snapsafety is not supported by the kernel. This is
+ * a useful failure mode for testing purposes.
+ * If it detects support, it will attempt to initialise. If the initialisation
+ * fails, this function will fail closed.
+ *
+ * Return 1 if successful or "failing open". Returns 0 otherwise.
+ */
+int aws_snapsafe_get_sgn(uint32_t *sgn)
+{
+    int ret = 0;
+
+    if (do_aws_snapsafe_init_once() != 1) {
+        *sgn = 0;
+        return 0;
+    }
+
+    /* We don't mutate the sgn here, so read lock is sufficient. */
+    if (!CRYPTO_THREAD_read_lock(sgn_mutex)) {
+        goto err;
+    }
+
+    if (snapsafety_state == SNAPSAFETY_STATE_FAILED_INITIALISE) {
+        *sgn = 0;
+        goto err;
+    }
+
+    if (test_mode == SNAPSAFE_TEST_MODE_ENABLED) {
+        *sgn = test_mode_sgn;
+        ret = 1;
+        goto err;
+    }
+
+    if (snapsafety_state == SNAPSAFETY_STATE_NOT_SUPPORTED) {
+        *sgn = 0;
+        ret = 1;
+        goto err;
+    }
+
+    *sgn = aws_snapsafe_read_sgn();
+    ret = 1;
+
+err:
+    CRYPTO_THREAD_unlock(sgn_mutex);
+    return ret;
+}
+
+/* aws_snapsafe_is_supported returns 1 if snapsafety is expected to be supported,
+ * 0 otherwise. */
+int aws_snapsafe_is_supported(void)
+{
+    return aws_snapsafe_check_kernel_support();
+}
+
+/* aws_snapsafe_is_initialised returns 1 if snapsafety is initialised and 0
+ * otherwise. */
+int aws_snapsafe_is_initialised(void)
+{
+    if (snapsafety_state != SNAPSAFETY_STATE_SUCCESS_INITIALISE) {
+        return 0;
+    }
+    return 1;
+}
+
+/* aws_snapsafe_get_entropy returns buf_size bytes of entropy in buf. Good for
+ * seed entropy. Returns 1 if successful and 0 otherwise.
+ * buf_size should be equal to the strength times 8.*/
+int aws_snapsafe_get_entropy(unsigned char *buf, size_t buf_size)
+{
+    return aws_snapsafe_get_entropy_from_source(buf, buf_size);
+}
+
+/* aws_snapsafe_enable_test_mode_FOR_TESTING enables manual control of the sgn. */
+void aws_snapsafe_enable_test_mode_FOR_TESTING(void)
+{
+    if (test_mode == SNAPSAFE_TEST_MODE_DISABLED) {
+        /* First time enabling (or re-enabling) test mode, set the current sgn
+         * to the test mode sgn. */
+        test_mode_sgn = aws_snapsafe_read_sgn();
+    }
+    test_mode = SNAPSAFE_TEST_MODE_ENABLED;
+}
+
+/* aws_snapsafe_disable_test_mode_FOR_TESTING disables manual control of the sgn. */
+void aws_snapsafe_disable_test_mode_FOR_TESTING(void)
+{
+    test_mode = SNAPSAFE_TEST_MODE_DISABLED;
+}
+
+/* aws_snapsafe_increment_sgn_FOR_TESTING increments the sgn. Returns 1 if
+ * successful and 0 otherwise. */
+int aws_snapsafe_increment_sgn_FOR_TESTING(void)
+{
+    int ret = 0;
+
+    /* Mutating the sgn, so grab a write lock. */
+    if (!CRYPTO_THREAD_write_lock(sgn_mutex)) {
+        goto err;
+    }
+
+    if (test_mode != SNAPSAFE_TEST_MODE_ENABLED) {
+        int fd_sgn = open(sgc_file_path, O_RDONLY);
+        if (fd_sgn == -1) {
+            goto err;
+        }
+
+        uint32_t incremented_sgn = aws_snapsafe_read_sgn() + 1;
+        if (ioctl(fd_sgn, SYSGENID_TRIGGER_GEN_UPDATE, incremented_sgn) == -1) {
+            fprintf(stderr, "%s error: %s\n", __func__, strerror(errno));
+            close(fd_sgn);
+            goto err;
+        }
+
+        if (close(fd_sgn) == -1) {
+            goto err;
+        }
+
+        if (incremented_sgn != aws_snapsafe_read_sgn()) {
+            /* This would be weird, but something must be wrong with the IOCTL. */
+            goto err;
+        }
+    } else {
+       test_mode_sgn = test_mode_sgn + 1;
+    }
+
+    ret = 1;
+
+err:
+    CRYPTO_THREAD_unlock(sgn_mutex);
+    return ret;
+}
